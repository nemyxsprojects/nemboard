<Window x:Class="Soundboard.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to NemBoard" Width="540" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/NemBoard.ico">
  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <DockPanel>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Viewbox Width="20" Height="20" Margin="0,0,9,0">
          <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,12 L 2,8 M 7,16 L 7,4 M 12,19 L 12,1 M 17,16 L 17,4 M 22,12 L 22,8" />
        </Viewbox>
        <TextBlock Text="NemBoard" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="White" Margin="3" />
        <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="#555555" Margin="3" />
        <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="#555555" Margin="3" />
        <Ellipse x:Name="Dot4" Width="6" Height="6" Fill="#555555" Margin="3" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,28,0,18">
      <StackPanel x:Name="WelcomePage" VerticalAlignment="Center" MaxWidth="420">
        <TextBlock x:Name="WelcomeTitle" Text="Let’s set up NemBoard" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="WelcomeCopy" Text="This takes less than a minute. We’ll choose your microphone and headphones, then show you the last setting to use in Discord." Foreground="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0" />
        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,22,0,0">
          <TextBlock x:Name="WelcomeRoute" Text="Your voice + sounds + PC audio → CABLE Output" FontSize="12" Foreground="#E5E5E5" />
        </Border>
      </StackPanel>

      <StackPanel x:Name="MicrophonePage" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="440">
        <TextBlock x:Name="MicrophoneTitle" Text="Choose your microphone" FontSize="23" FontWeight="SemiBold" />
        <TextBlock x:Name="MicrophoneCopy" Text="Select the microphone you normally speak into." Foreground="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18" />
        <TextBlock x:Name="MicrophoneLabel" Text="MICROPHONE" FontSize="11" FontWeight="Bold" Foreground="#AFAFAF" Margin="0,0,0,7" />
        <ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="Name" SelectionChanged="DeviceSelectionChanged" />
      </StackPanel>

      <StackPanel x:Name="MonitorPage" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="440">
        <TextBlock x:Name="MonitorTitle" Text="Choose where you listen" FontSize="23" FontWeight="SemiBold" />
        <TextBlock x:Name="MonitorCopy" Text="NemBoard keeps playing everything in these headphones while sending the same mix to VB-CABLE." Foreground="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18" />
        <TextBlock x:Name="MonitorLabel" Text="HEADPHONES OR SPEAKERS" FontSize="11" FontWeight="Bold" Foreground="#AFAFAF" Margin="0,0,0,7" />
        <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Name" SelectionChanged="DeviceSelectionChanged" />
        <DockPanel Margin="0,12,0,0">
          <Button x:Name="TestButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Test" Click="TestButton_Click" />
          <Ellipse x:Name="CableDot" Width="7" Height="7" Fill="#03FC56" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="CableStatus" Text="VB-CABLE is ready" Foreground="#DADADA" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>

      <StackPanel x:Name="AppsPage" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="440">
        <TextBlock x:Name="AppsTitle" Text="One last setting" FontSize="23" FontWeight="SemiBold" />
        <TextBlock x:Name="AppsCopy" Text="In Discord, a game or a calling app, open its microphone settings and select:" Foreground="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,16" />
        <Border Background="#222222" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" Padding="16,13">
          <DockPanel>
            <Ellipse Width="8" Height="8" Fill="#03FC56" Margin="0,0,10,0" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock Text="CABLE Output (VB-Audio Virtual Cable)" FontWeight="SemiBold" FontSize="14" />
              <TextBlock x:Name="AppsHint" Text="Use this as the input / microphone device." Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBlock x:Name="AppsDone" Text="That’s it. NemBoard will remember the devices you selected." Foreground="#E5E5E5" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
      </StackPanel>
    </Grid>

    <DockPanel Grid.Row="2">
      <TextBlock x:Name="StepText" Text="1 / 4" Foreground="#8F8F8F" FontSize="11" VerticalAlignment="Center" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="BackButton" Style="{StaticResource FlatButton}" Content="Back" Visibility="Collapsed" Margin="0,0,8,0" Click="BackButton_Click" />
        <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="Start" MinWidth="92" Click="NextButton_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
